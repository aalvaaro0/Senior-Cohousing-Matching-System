<http://tfg.upm.es/alvaro/cohousing-senior> a owl:Ontology ;
    rdfs:label "Algoritmo de matching Senior Co-Housing" ;
    rdfs:comment "Filtro para buscar la mejor convivencia posible entre personas mayores" ;
    owl:versionIRI <http://purl.org/vivienda/cohousing-senior> .

h:ActividadFísica a owl:Class ;
    rdfs:subClassOf h:Hobby .

h:ActividadSocial a owl:Class ;
    rdfs:subClassOf h:NivelRuido .

h:Alerta_DeterioroCognitivo a h:RiesgoDeterioroCognitivo,
        owl:NamedIndividual ;
    rdfs:label "Alerta de deterioro cognitivo (MEC-Lobo < 24)" .

h:Ascensor a owl:Class ;
    rdfs:subClassOf h:EquipamientoAccesibilidad .

h:Biblio_Principal a h:Biblioteca,
        owl:NamedIndividual .

h:Celíaco a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:ControlAnticoagulantes a owl:Class ;
    rdfs:subClassOf h:NecesidadMédica .

h:ControlInsulina a owl:Class ;
    rdfs:subClassOf h:NecesidadMédica .

h:CuidadoIncontinencia a owl:Class ;
    rdfs:subClassOf h:NecesidadMédica .

h:CuidadoOstomía a owl:Class ;
    rdfs:subClassOf h:NecesidadMédica .

h:DietaBlanda a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:FisioterapiaFrecuente a owl:Class ;
    rdfs:subClassOf h:NecesidadMédica .

h:Gato a owl:Class ;
    rdfs:subClassOf h:AfinidadMascotas ;
    owl:disjointWith h:Ninguna .

h:HabitacionDoble_101 a h:HabitacionDoble,
        owl:NamedIndividual .

h:Hombre a h:Sexo,
        owl:NamedIndividual ;
    owl:sameAs <http://www.semanticweb.org/alvaro/ontologies/2026/2/untitled-ontology-2#Hombre> .

h:IntoleranteLactosa a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:Jardinería a owl:Class ;
    rdfs:subClassOf h:Hobby .

h:JuegosMesa a owl:Class ;
    rdfs:subClassOf h:Hobby .

h:Lectura a owl:Class ;
    rdfs:subClassOf h:Hobby .

h:Mujer a h:Sexo,
        owl:NamedIndividual ;
    owl:sameAs <http://www.semanticweb.org/alvaro/ontologies/2026/2/untitled-ontology-2#Mujer> .

h:Oxigenoterapia a owl:Class ;
    rdfs:subClassOf h:NecesidadMédica .

h:Rampa a owl:Class ;
    rdfs:subClassOf h:EquipamientoAccesibilidad .

h:ResidenteConRiesgoCardiaco a owl:Class ;
    rdfs:comment "Residente con riesgo cardíaco (taquicardia: Heart_Rate > 100 bpm)." ;
    rdfs:subClassOf h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:onProperty h:tieneRiesgoSalud ;
                        owl:someValuesFrom h:RiesgoCardiaco ] ) ] .

h:ResidenteFumador a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty h:estaCasadoCon ;
                        owl:someValuesFrom h:Residente ] [ a owl:Restriction ;
                        owl:allValuesFrom h:HabitacionIndividual ;
                        owl:onProperty h:asignadoAHabitacion ] ) ],
        h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty h:esFumador ] ) ] .

h:ResidenteMovilidadReducida a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty h:asignadoAHabitacion ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty h:tieneEquipamiento ;
                    owl:someValuesFrom h:BarraApoyo ] ],
        h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty h:ayudaCaminar ] ) ] .

h:ResidenteRiesgoAtragantamiento a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue h:Menu_Triturado ;
            owl:onProperty h:comparteDietaCon ],
        h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:hasValue h:Alerta_Atragantamiento ;
                        owl:onProperty h:tieneRiesgoSalud ] ) ] .

h:ResidenteRiesgoCaida a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty h:asignadoAHabitacion ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty h:tieneEquipamiento ;
                    owl:someValuesFrom h:BarraApoyo ] ],
        h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:onProperty h:tieneRiesgoSalud ;
                        owl:someValuesFrom h:RiesgoCaida ] ) ] .

h:RicaEnFibra a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:SupervisionTensionDiaria a owl:Class ;
    rdfs:subClassOf h:NecesidadMédica .

h:UsuarioSillaRuedas a owl:Class ;
    rdfs:subClassOf h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty h:usaSillaRuedas ] ) ] .

h:Vegano a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:Vegetariano a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

