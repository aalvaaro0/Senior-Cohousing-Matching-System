[] a ns1:Imp ;
    rdfs:label "Compatibilidad_AficionCompartida" ;
    ns2:isRuleEnabled true ;
    rdfs:comment "comparteAficionCon(r1,r2) → esCompatibleCon(r1,r2)." ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 h:r1 ;
                    ns1:classPredicate h:Residente ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:ClassAtom ;
                            ns1:argument1 h:r2 ;
                            ns1:classPredicate h:Residente ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:IndividualPropertyAtom ;
                                    ns1:argument1 h:r1 ;
                                    ns1:argument2 h:r2 ;
                                    ns1:propertyPredicate h:comparteAficionCon ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:DifferentIndividualsAtom ;
                                            ns1:argument1 h:r1 ;
                                            ns1:argument2 h:r2 ] ;
                                    rdf:rest () ] ] ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 h:r1 ;
                    ns1:argument2 h:r2 ;
                    ns1:propertyPredicate h:esCompatibleCon ] ;
            rdf:rest () ] .

