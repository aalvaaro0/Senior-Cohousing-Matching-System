<http://tfg.upm.es/alvaro/cohousing-senior#gol> a ns1:Variable .

h:Abstemio a owl:Class ;
    rdfs:subClassOf h:ConsumoAlcohol .

h:Alerta_Ansiedad a h:RiesgoAnsiedad,
        owl:NamedIndividual ;
    rdfs:label "Alerta de ansiedad clínica (Goldberg ≥ 5)" .

h:Alerta_Cardiaco a h:RiesgoCardiaco,
        owl:NamedIndividual ;
    rdfs:label "Alerta de riesgo cardíaco (Heart_Rate > 100 bpm)" .

h:Alerta_Depresion a h:RiesgoDepresion,
        owl:NamedIndividual ;
    rdfs:label "Alerta de depresión clínica (GDS ≥ 5)" .

h:Alerta_Hipertension a h:RiesgoHipertension,
        owl:NamedIndividual ;
    rdfs:label "Alerta de hipertensión (presionSistolica ≥ 140 mmHg)" .

h:AsistenciaNocturna a owl:Class ;
    rdfs:subClassOf h:NecesidadMédica .

h:AtencionPaliativa a h:NecesidadMédica,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Atención paliativa (NECPAL ≥ 1)" ;
    rdfs:comment "Necesidad de atención paliativa (NECPAL ≥ 1)." ;
    rdfs:subClassOf h:NecesidadMédica .

h:BajoEnSal a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:Bebedor a owl:Class ;
    rdfs:subClassOf h:ConsumoAlcohol .

h:Diabético a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:Español a h:Idioma,
        owl:NamedIndividual ;
    h:hablaIdioma h:Español .

h:Gym a owl:Class ;
    rdfs:subClassOf h:ZonaComún .

h:Hipocalórica a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:Madrugador a owl:Class ;
    rdfs:subClassOf h:CicloSueño ;
    owl:disjointWith h:Noctámbulo .

h:Menu_Bajo_En_Sal a h:BajoEnSal,
        owl:NamedIndividual ;
    rdfs:label "Menú bajo en sal (presionSistolica ≥ 140 mmHg)" .

h:Menu_Diabetico a h:Diabético,
        owl:NamedIndividual .

h:Ninguna a owl:Class ;
    rdfs:subClassOf h:AfinidadMascotas ;
    owl:disjointWith h:Perro .

h:NoMasticable a owl:Class ;
    rdfs:subClassOf h:DietaEspecial .

h:Ocasional a owl:Class ;
    rdfs:subClassOf h:ConsumoAlcohol .

h:Perro a owl:Class ;
    rdfs:subClassOf h:AfinidadMascotas .

h:ProtocoloAntiescara a h:NecesidadMédica,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Protocolo de prevención de úlceras por presión (Norton ≤ 14)" ;
    rdfs:comment "Protocolo de prevención de úlceras por presión (Norton ≤ 14)." ;
    rdfs:subClassOf h:NecesidadMédica .

h:Religión a owl:Class ;
    rdfs:subClassOf h:PreferenciaCultural .

h:ResidenteAnsioso a owl:Class ;
    rdfs:comment "Residente con riesgo de ansiedad clínica (Goldberg ≥ 5). Clasificado por la regla SWRL Riesgo_Ansiedad_Goldberg." ;
    rdfs:subClassOf h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:onProperty h:tieneRiesgoSalud ;
                        owl:someValuesFrom h:RiesgoAnsiedad ] ) ] .

h:ResidenteConIncontinencia a owl:Class ;
    rdfs:comment "Residente con incontinencia urinaria/fecal (usaPañales = true). Clasificado por SWRL R-Nuevo-15." ;
    rdfs:subClassOf h:Residente .

h:ResidenteDeprimido a owl:Class ;
    rdfs:comment "Residente con riesgo de depresión clínica (GDS ≥ 5). Clasificado por la regla SWRL Riesgo_Depresion_GDS." ;
    rdfs:subClassOf h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:onProperty h:tieneRiesgoSalud ;
                        owl:someValuesFrom h:RiesgoDepresion ] ) ] .

h:ResidenteDiabetico a owl:Class ;
    rdfs:comment "Residente diabético (tieneDiabetes = true). Clasificado por SWRL R-Nuevo-17." ;
    rdfs:subClassOf h:Residente .

h:ResidenteHipertenso a owl:Class ;
    rdfs:comment "Residente hipertenso (presionSistolica ≥ 140 mmHg). Activa dieta baja en sal y SupervisionTensionDiaria." ;
    rdfs:subClassOf h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:onProperty h:tieneRiesgoSalud ;
                        owl:someValuesFrom h:RiesgoHipertension ] ) ] .

h:ResidenteObeso a owl:Class ;
    rdfs:comment "Residente con obesidad (tieneObesidad = true). Clasificado por SWRL R-Nuevo-16." ;
    rdfs:subClassOf h:Residente .

h:RiesgoAtragantamiento a owl:Class ;
    rdfs:subClassOf h:RiesgoSalud .

h:RiesgoCaidaInd a h:RiesgoCaida,
        owl:NamedIndividual .

h:RiesgoUlceras a owl:Class ;
    rdfs:subClassOf h:RiesgoSalud .

h:Silencioso a owl:Class ;
    rdfs:subClassOf h:NivelRuido .

h:SupervisionMedicacion a h:NecesidadMédica,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Supervisión de medicación (NPI ≥ 4 o demencia)" ;
    rdfs:comment "Supervisión de medicación para residentes con alteraciones conductuales (NPI ≥ 4)." ;
    rdfs:subClassOf h:NecesidadMédica .

h:TV a owl:Class ;
    rdfs:subClassOf h:ZonaComún .

h:Terraza a owl:Class ;
    rdfs:subClassOf h:ZonaComún .

h:ayudaCaminar a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty ;
    owl:equivalentProperty h:usaProductosApoyo .

h:esFamiliarDe a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:Residente ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:prefiereCompañeroDeGénero a owl:ObjectProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:Sexo ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:rechazaConvivirCon a owl:ObjectProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:Residente ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:tieneGradoDependencia a owl:ObjectProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:GradoDependencia ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:tieneMascota a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

h:tienePerdidaMemoria a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

h:toleraMascotas a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

h:usaProductosApoyo a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

d:Alerta_DeterioroCognitivo a h:RiesgoDeterioroCognitivo,
        h:RiesgoSalud,
        owl:NamedIndividual ;
    rdfs:comment "MEC-Lobo ≤ 23 o Pfeiffer ≥ 5 — deterioro cognitivo moderado-severo" .

