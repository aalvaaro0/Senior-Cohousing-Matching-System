        owl:NamedIndividual ;
    rdfs:label "Alerta de aislamiento social (sin visitas, vivía solo)" .

h:Alerta_Ulceras a h:RiesgoUlceras,
        owl:NamedIndividual .

h:BarraApoyo a owl:Class ;
    rdfs:subClassOf h:EquipamientoAccesibilidad .

h:BañoAdaptado a owl:Class ;
    rdfs:subClassOf h:EquipamientoAccesibilidad .

h:Biblioteca a owl:Class ;
    rdfs:subClassOf h:ZonaComún .

h:GradoDependencia a owl:Class ;
    rdfs:subClassOf owl:Thing .

h:HabitacionDoble a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass h:Residente ;
            owl:onProperty h:alojaAResidente ],
        h:Habitacion ;
    owl:disjointWith h:HabitacionIndividual .

h:Heart_Rate a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

h:Menu_Bajo_Colesterol a h:DietaEspecial,
        h:Hipocalórica,
        owl:NamedIndividual ;
    rdfs:label "Menú bajo en colesterol (colesterol ≥ 240 mg/dL)" .

h:Moderado a owl:Class ;
    rdfs:subClassOf h:NivelActividad .

h:Noctámbulo a owl:Class ;
    rdfs:subClassOf h:CicloSueño .

h:Perfil_Activo a h:Activo,
        owl:NamedIndividual ;
    rdfs:label "Perfil activo (≥ 5 días de actividad física/semana)" .

h:Perfil_Moderado a h:Moderado,
        owl:NamedIndividual ;
    rdfs:label "Perfil moderado (2–4 días de actividad física/semana)" .

h:Perfil_Sedentario a h:Sedentario,
        owl:NamedIndividual ;
    rdfs:label "Perfil sedentario (≤ 1 día de actividad física/semana)" .

h:PreferenciaCultural a owl:Class ;
    rdfs:subClassOf owl:Thing .

h:ResidenteConDemencia a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty h:tieneNecesidadMedica ;
            owl:someValuesFrom h:AsistenciaNocturna ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty h:necesitaAsistenciaNocturna ],
        h:Residente ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( h:Residente [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty h:tienePerdidaMemoria ] ) ] .

h:RiesgoAislamientoSocial a owl:Class ;
    rdfs:comment "Riesgo de aislamiento social: sin visitas frecuentes + vivía solo" ;
    rdfs:subClassOf h:RiesgoSalud .

h:RiesgoCaida a owl:Class ;
    rdfs:subClassOf h:RiesgoSalud .

h:RiesgoDeterioroCognitivo a owl:Class ;
    rdfs:comment "Riesgo de deterioro cognitivo: MEC-Lobo ≤ 23 o Pfeiffer ≥ 5" ;
    rdfs:subClassOf h:RiesgoSalud .

h:Sedentario a owl:Class ;
    rdfs:subClassOf h:NivelActividad .

h:alojaAResidente a owl:ObjectProperty ;
    rdfs:domain h:Habitacion ;
    rdfs:range h:Residente ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf h:asignadoAHabitacion .

h:comparteHabitacionCon a owl:ObjectProperty,
        owl:SymmetricProperty ;
