                    rdf:rest () ] ] ;
    ns1:head [ a ns1:AtomList ;
            rdf:first [ a ns1:IndividualPropertyAtom ;
                    ns1:argument1 h:r ;
                    ns1:argument2 h:Alerta_Ulceras ;
                    ns1:propertyPredicate h:tieneRiesgoSalud ] ;
            rdf:rest () ] .

