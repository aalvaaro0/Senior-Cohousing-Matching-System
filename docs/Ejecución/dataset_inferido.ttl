h:tieneMismoCicloSueñoQue a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:Residente ;
    rdfs:subPropertyOf owl:topObjectProperty .

