[] a ns1:Imp ;
    rdfs:label "Actividad_PerfilActivo" ;
    ns2:isRuleEnabled true ;
    rdfs:comment "Residente con 5 o más días de actividad física semanales es Activo." ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 <http://tfg.upm.es/alvaro/cohousing-senior#r> ;
                    ns1:classPredicate h:Residente ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                            ns1:argument1 <http://tfg.upm.es/alvaro/cohousing-senior#r> ;
                            ns1:argument2 <http://tfg.upm.es/alvaro/cohousing-senior#d> ;
                            ns1:propertyPredicate h:diasActividadFisica ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:BuiltinAtom ;
                                    ns1:arguments [ a rdf:List ;
                                            rdf:first <http://tfg.upm.es/alvaro/cohousing-senior#d> ;
                                            rdf:rest [ a rdf:List ;
