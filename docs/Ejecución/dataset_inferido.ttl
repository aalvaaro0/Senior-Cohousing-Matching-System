    rdfs:subClassOf h:Característica .

h:ResidenteNivel1 a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom h:HabitacionIndividual ;
            owl:onProperty h:asignadoAHabitacion ],
        [ a owl:Restriction ;
            owl:hasValue h:Nivel1 ;
            owl:onProperty h:tieneNivelConvivencia ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty h:necesitaAsistenciaNocturna ],
        h:Residente .

h:ResidenteNivel2 a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty h:asignadoAHabitacion ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty h:tieneEquipamiento ;
                    owl:someValuesFrom h:BañoAdaptado ] ],
        [ a owl:Restriction ;
            owl:hasValue h:Nivel2 ;
            owl:onProperty h:tieneNivelConvivencia ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty h:necesitaAsistenciaNocturna ],
        h:Residente .

h:ResidenteNivel3 a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty h:asignadoAHabitacion ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty h:tieneEquipamiento ;
                    owl:someValuesFrom h:BañoAdaptado ] ],
        [ a owl:Restriction ;
            owl:hasValue h:Nivel3 ;
            owl:onProperty h:tieneNivelConvivencia ],
        [ a owl:Restriction ;
            owl:hasValue true ;
            owl:onProperty h:necesitaAsistenciaNocturna ],
        h:Residente .

h:ResidenteNivel5 a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue h:Nivel5 ;
            owl:onProperty h:tieneNivelConvivencia ],
        h:Residente .

