d:Alerta_Ansiedad a h:RiesgoAnsiedad,
        h:RiesgoSalud,
        owl:NamedIndividual ;
    rdfs:comment "Goldberg ≥ 5 — ansiedad clínicamente relevante (Goldberg Anxiety Scale)" .

d:Alerta_Depresion a h:RiesgoDepresion,
        h:RiesgoSalud,
        owl:NamedIndividual ;
    rdfs:comment "GDS ≥ 5 — puntuación indicativa de depresión geriátrica significativa (Yesavage 1982)" .

