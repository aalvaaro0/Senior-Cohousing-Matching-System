        owl:ObjectProperty ;
    rdfs:range h:Sexo ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:ayudaVestir a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

h:compartePreferenciaDeRuidoCon a owl:ObjectProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:NivelRuido ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:consumeAlcohol a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf owl:topDataProperty .

h:fechaInicio a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf owl:topDataProperty .

h:frecuenciaVisitasFamiliares a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

h:género a owl:DatatypeProperty ;
    rdfs:domain h:Persona,
        h:Residente ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

h:horasDeSueno a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

h:instaladoEn a owl:ObjectProperty ;
    rdfs:domain h:EquipamientoAccesibilidad ;
    rdfs:range h:Habitacion ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf h:tieneEquipamiento .

h:nivelDependencia a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

h:nivelEstres a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

h:nivelToleranciaRuido a owl:ObjectProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:NivelRuido ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:nombre a owl:DatatypeProperty ;
    rdfs:domain h:Persona,
        h:Residente ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

h:practicaReligion a owl:ObjectProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:Religión ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:presionDiastolica a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

h:presupuesto a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

h:puntuacionCompatibilidadTotal a owl:DatatypeProperty ;
    rdfs:domain h:Residente ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

h:tieneAfinidadMedicaCon a owl:ObjectProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:NecesidadMédica ;
    rdfs:subPropertyOf owl:topObjectProperty .

h:tieneEdad a owl:DatatypeProperty ;
    rdfs:domain h:Persona,
        h:Residente ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

h:tieneHobby a owl:ObjectProperty ;
    rdfs:domain h:Residente ;
    rdfs:range h:Hobby ;
