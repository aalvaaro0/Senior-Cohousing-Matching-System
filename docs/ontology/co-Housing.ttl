###  http://tfg.upm.es/alvaro/cohousing-senior#Edu
:Edu rdf:type owl:NamedIndividual ,
              :Residente ;
     :puntuacionBarthel 85 ;
     :puntuacionMecLobo 35 ;
     :puntuacionNorton 10 ;
     :puntuacionTinetti 12 .


