:Persona rdf:type owl:Class ;
         rdfs:subClassOf owl:Thing .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Rampa
:Rampa rdf:type owl:Class ;
       rdfs:subClassOf :EquipamientoAccesibilidad .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Residente
:Residente rdf:type owl:Class ;
           rdfs:subClassOf :Persona .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteFumador
:ResidenteFumador rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :Residente
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :esFumador ;
                                                               owl:hasValue "true"^^xsd:boolean
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :Residente ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :asignadoAHabitacion ;
                                    owl:allValuesFrom :HabitacionIndividual
                                  ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel1
:ResidenteNivel1 rdf:type owl:Class ;
                 rdfs:subClassOf :Residente ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :tieneNivelConvivencia ;
                                   owl:hasValue :Nivel1
                                 ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel2
:ResidenteNivel2 rdf:type owl:Class ;
                 rdfs:subClassOf :Residente ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :tieneNivelConvivencia ;
                                   owl:hasValue :Nivel2
                                 ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel3
:ResidenteNivel3 rdf:type owl:Class ;
                 rdfs:subClassOf :Residente ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :tieneNivelConvivencia ;
                                   owl:hasValue :Nivel3
                                 ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel4
:ResidenteNivel4 rdf:type owl:Class ;
                 rdfs:subClassOf :Residente ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :tieneNivelConvivencia ;
                                   owl:hasValue :Nivel4
                                 ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel5
:ResidenteNivel5 rdf:type owl:Class ;
                 rdfs:subClassOf :Residente ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :tieneNivelConvivencia ;
                                   owl:hasValue :Nivel5
                                 ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel6
:ResidenteNivel6 rdf:type owl:Class ;
                 rdfs:subClassOf :Residente ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :tieneNivelConvivencia ;
                                   owl:hasValue :Nivel6
                                 ] .


