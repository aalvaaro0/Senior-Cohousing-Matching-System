###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Residente
h:Residente rdf:type owl:Class ;
            rdfs:subClassOf h:Persona ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty h:tieneCicloSueño ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass h:CicloSueño
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty h:tieneGenero ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass h:Sexo
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty h:tieneGradoDependencia ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass h:GradoDependencia
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty h:toleraNivelRuido ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass h:NivelRuido
                            ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteConDemencia
h:ResidenteConDemencia rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( h:Residente
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty h:tienePerdidaMemoria ;
                                                                    owl:hasValue "true"^^xsd:boolean
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf h:Residente ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty h:tieneNecesidadMedica ;
                                         owl:someValuesFrom h:AsistenciaNocturna
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty h:necesitaAsistenciaNocturna ;
                                         owl:hasValue "true"^^xsd:boolean
                                       ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteFumador
h:ResidenteFumador rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( h:Residente
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty h:esFumador ;
                                                                owl:hasValue "true"^^xsd:boolean
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf h:Residente ,
                                   [ rdf:type owl:Class ;
                                     owl:unionOf ( [ rdf:type owl:Restriction ;
                                                     owl:onProperty h:estaCasadoCon ;
                                                     owl:someValuesFrom h:Residente
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty h:asignadoAHabitacion ;
                                                     owl:allValuesFrom h:HabitacionIndividual
                                                   ]
                                                 )
                                   ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteMovilidadReducida
h:ResidenteMovilidadReducida rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( h:Residente
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty h:ayudaCaminar ;
                                                                          owl:hasValue "true"^^xsd:boolean
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf h:Residente ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty h:asignadoAHabitacion ;
                                               owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                    owl:onProperty h:tieneEquipamiento ;
                                                                    owl:someValuesFrom h:BarraApoyo
                                                                  ]
                                             ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel1
h:ResidenteNivel1 rdf:type owl:Class ;
                  rdfs:subClassOf h:Residente ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:asignadoAHabitacion ;
                                    owl:allValuesFrom h:HabitacionIndividual
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:tieneNivelConvivencia ;
                                    owl:hasValue h:Nivel1
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:necesitaAsistenciaNocturna ;
                                    owl:hasValue "true"^^xsd:boolean
                                  ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel2
h:ResidenteNivel2 rdf:type owl:Class ;
                  rdfs:subClassOf h:Residente ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:asignadoAHabitacion ;
                                    owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                         owl:onProperty h:tieneEquipamiento ;
                                                         owl:someValuesFrom h:BañoAdaptado
                                                       ]
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:tieneNivelConvivencia ;
                                    owl:hasValue h:Nivel2
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:necesitaAsistenciaNocturna ;
                                    owl:hasValue "true"^^xsd:boolean
                                  ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel3
h:ResidenteNivel3 rdf:type owl:Class ;
                  rdfs:subClassOf h:Residente ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:asignadoAHabitacion ;
                                    owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                         owl:onProperty h:tieneEquipamiento ;
                                                         owl:someValuesFrom h:BañoAdaptado
                                                       ]
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:tieneNivelConvivencia ;
                                    owl:hasValue h:Nivel3
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:necesitaAsistenciaNocturna ;
