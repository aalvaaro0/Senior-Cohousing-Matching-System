#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( h:Abstemio
                h:Bebedor
                h:Ocasional
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( h:Activo
                h:Moderado
                h:Sedentario
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( h:Biblioteca
                h:Gym
                h:TV
                h:Terraza
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( h:Característica
                h:Infraestructura
                h:Persona
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( h:EquipamientoAccesibilidad
                h:Habitacion
                h:ZonaComún
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( h:ResidenteNivel1
                h:ResidenteNivel2
                h:ResidenteNivel3
                h:ResidenteNivel4
                h:ResidenteNivel5
                h:ResidenteNivel6
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( h:Alvaro
                        h:Eva
                        h:Juan
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( h:Alvaro
                        h:Eva
                        h:Juan
                        h:Maria
                        h:Paco
                      )
] .


