#################################################################
#    Individuals
#################################################################

###  http://tfg.upm.es/alvaro/cohousing-senior#Español
:Español rdf:type owl:NamedIndividual ,
                  :Idioma ;
         :hablaIdioma :Español .


###  http://tfg.upm.es/alvaro/cohousing-senior#Maria
:Maria rdf:type owl:NamedIndividual ,
                :Residente ;
       :hablaIdioma :Español .


###  http://tfg.upm.es/alvaro/cohousing-senior#Paco
:Paco rdf:type owl:NamedIndividual ,
               :Residente ;
      :hablaIdioma :Español .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Alvaro
:Alvaro rdf:type owl:NamedIndividual ,
                 :Residente ;
        :esFumador "false"^^xsd:boolean .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Biblio_Principal
:Biblio_Principal rdf:type owl:NamedIndividual ,
                           :Biblioteca .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Eva
:Eva rdf:type owl:NamedIndividual ,
              :Residente ;
     :frecuentaZonaComun :Biblio_Principal ;
     :esFumador "true"^^xsd:boolean .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Hombre
:Hombre rdf:type owl:NamedIndividual ,
                 :Sexo .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Juan
:Juan rdf:type owl:NamedIndividual ,
               :Residente ;
      :frecuentaZonaComun :Biblio_Principal ;
      :esFumador "true"^^xsd:boolean .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Mujer
:Mujer rdf:type owl:NamedIndividual ,
                :Sexo .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Nivel1
:Nivel1 rdf:type owl:NamedIndividual ,
                 :NivelConvivencia .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Nivel2
:Nivel2 rdf:type owl:NamedIndividual ,
                 :NivelConvivencia .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Nivel3
:Nivel3 rdf:type owl:NamedIndividual ,
                 :NivelConvivencia .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Nivel4
:Nivel4 rdf:type owl:NamedIndividual ,
                 :NivelConvivencia .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Nivel5
:Nivel5 rdf:type owl:NamedIndividual ,
                 :NivelConvivencia .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Nivel6
:Nivel6 rdf:type owl:NamedIndividual ,
                 :NivelConvivencia .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Característica
                :Infraestructura
                :Persona
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Español
                        :Maria
                        :Alvaro
                        :Eva
                        :Juan
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Maria
                        :Paco
                        :Alvaro
                        :Eva
                        :Juan
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Alvaro
                        :Eva
                        :Juan
                      )
] .


#################################################################
#    Rules
#################################################################

:r1 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:r2 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:m rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:z rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:i rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "No_Mascotas" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Residente ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :r1
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :Residente ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :r2
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DifferentIndividualsAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :r1 ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :r2
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :tieneMascota ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :r1 ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> "true"^^xsd:boolean
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#propertyPredicate> :toleraMascotas ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :r2 ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument2> "false"^^xsd:boolean
                                                                                                 ] ;
                                                                                       rdf:rest rdf:nil
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :esIncompatibleCon ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :r1 ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :r2
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "Gusta_Mascota" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Residente ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :r1
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :Residente ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :r2
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
