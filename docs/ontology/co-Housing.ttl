h:ResidenteRiesgoAtragantamiento rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( h:Residente
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty h:tieneRiesgoSalud ;
