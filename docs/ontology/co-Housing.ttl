h:Sexo rdf:type owl:Class ;
       rdfs:subClassOf owl:Thing .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Silencioso
h:Silencioso rdf:type owl:Class ;
             rdfs:subClassOf h:NivelRuido .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/SupervisionTensionDiaria
h:SupervisionTensionDiaria rdf:type owl:Class ;
                           rdfs:subClassOf h:NecesidadMédica .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/TV
h:TV rdf:type owl:Class ;
     rdfs:subClassOf h:ZonaComún .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Terraza
h:Terraza rdf:type owl:Class ;
          rdfs:subClassOf h:ZonaComún .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/UsuarioSillaRuedas
h:UsuarioSillaRuedas rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( h:Residente
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty h:usaSillaRuedas ;
                                                                  owl:hasValue "true"^^xsd:boolean
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf h:Residente .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Vegano
h:Vegano rdf:type owl:Class ;
         rdfs:subClassOf h:DietaEspecial .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/Vegetariano
h:Vegetariano rdf:type owl:Class ;
              rdfs:subClassOf h:DietaEspecial .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ZonaComún
h:ZonaComún rdf:type owl:Class ;
            rdfs:subClassOf h:Infraestructura .


