h:ResidenteNivel4 rdf:type owl:Class ;
                  rdfs:subClassOf h:Residente ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:tieneNivelConvivencia ;
                                    owl:hasValue h:Nivel4
                                  ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel5
h:ResidenteNivel5 rdf:type owl:Class ;
                  rdfs:subClassOf h:Residente ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:tieneNivelConvivencia ;
                                    owl:hasValue h:Nivel5
                                  ] .


###  http://www.semanticweb.org/alvar/ontologies/2026/2/untitled-ontology-2/ResidenteNivel6
h:ResidenteNivel6 rdf:type owl:Class ;
                  rdfs:subClassOf h:Residente ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:comparteHabitacionCon ;
                                    owl:allValuesFrom [ rdf:type owl:Class ;
                                                        owl:complementOf h:ResidenteNivel6
                                                      ]
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty h:tieneNivelConvivencia ;
