#################################################################
#    Classes
#################################################################

###  http://tfg.upm.es/alvaro/cohousing-senior#ResidenteConDemencia
:ResidenteConDemencia rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Residente
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :tienePerdidaMemoria ;
                                                                   owl:hasValue "true"^^xsd:boolean
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf :Residente ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :tieneNecesidadMedica ;
                                        owl:someValuesFrom :AsistenciaNocturna
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :necesitaAsistenciaNocturna ;
                                        owl:hasValue "true"^^xsd:boolean
                                      ] .


###  http://tfg.upm.es/alvaro/cohousing-senior#ResidenteMovilidadReducida
:ResidenteMovilidadReducida rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( :Residente
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :ayudaCaminar ;
                                                                         owl:hasValue "true"^^xsd:boolean
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf :Residente ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :asignadoAHabitacion ;
                                              owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :tieneEquipamiento ;
                                                                   owl:someValuesFrom :BarraApoyo
                                                                 ]
                                            ] .


###  http://tfg.upm.es/alvaro/cohousing-senior#ResidenteRiesgoAtragantamiento
:ResidenteRiesgoAtragantamiento rdf:type owl:Class ;
                                owl:equivalentClass [ owl:intersectionOf ( :Residente
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty :tieneRiesgoSalud ;
                                                                             owl:hasValue :Alerta_Atragantamiento
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ] ;
                                rdfs:subClassOf :Residente ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :comparteDietaCon ;
                                                  owl:hasValue :Menu_Triturado
                                                ] .


###  http://tfg.upm.es/alvaro/cohousing-senior#ResidenteRiesgoCaida
:ResidenteRiesgoCaida rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Residente
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :tieneRiesgoSalud ;
                                                                   owl:someValuesFrom :RiesgoCaida
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf :Residente ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :asignadoAHabitacion ;
                                        owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                             owl:onProperty :tieneEquipamiento ;
                                                             owl:someValuesFrom :BarraApoyo
                                                           ]
                                      ] .


###  http://tfg.upm.es/alvaro/cohousing-senior#UsuarioSillaRuedas
:UsuarioSillaRuedas rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Residente
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :usaSillaRuedas ;
                                                                 owl:hasValue "true"^^xsd:boolean
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :Residente .


