#################################################################
#    Classes
#################################################################

###  http://tfg.upm.es/alvaro/cohousing-senior#Abstemio
:Abstemio rdf:type owl:Class ;
          rdfs:subClassOf :ConsumoAlcohol .


###  http://tfg.upm.es/alvaro/cohousing-senior#Activo
:Activo rdf:type owl:Class ;
        rdfs:subClassOf :NivelActividad .


###  http://tfg.upm.es/alvaro/cohousing-senior#AsistenciaNocturna
:AsistenciaNocturna rdf:type owl:Class ;
                    rdfs:subClassOf :NecesidadMédica .


###  http://tfg.upm.es/alvaro/cohousing-senior#Bebedor
:Bebedor rdf:type owl:Class ;
         rdfs:subClassOf :ConsumoAlcohol .


###  http://tfg.upm.es/alvaro/cohousing-senior#ConsumoAlcohol
:ConsumoAlcohol rdf:type owl:Class ;
                rdfs:subClassOf :Hábito .


###  http://tfg.upm.es/alvaro/cohousing-senior#ControlAnticoagulantes
:ControlAnticoagulantes rdf:type owl:Class ;
                        rdfs:subClassOf :NecesidadMédica .


###  http://tfg.upm.es/alvaro/cohousing-senior#CuidadoIncontinencia
:CuidadoIncontinencia rdf:type owl:Class ;
