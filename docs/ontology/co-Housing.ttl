#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Abstemio
                :Bebedor
                :Ocasional
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Activo
                :Moderado
                :Sedentario
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Biblioteca
                :Gym
                :TV
                :Terraza
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Característica
                :Infraestructura
                :Persona
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :EquipamientoAccesibilidad
                :Habitacion
                :ZonaComún
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ResidenteNivel1
                :ResidenteNivel2
                :ResidenteNivel3
                :ResidenteNivel4
                :ResidenteNivel5
                :ResidenteNivel6
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Alvaro
                        :Eva
                        :Juan
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Alvaro
                        :Eva
                        :Juan
                        :Maria
                        :Paco
                      )
] .


